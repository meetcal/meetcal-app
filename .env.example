# The Convex deployment the app reads from (production shown). `npx convex dev`
# writes the dev deployment's URL into .env.local for local work.
EXPO_PUBLIC_CONVEX_URL=https://disciplined-hare-790.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_ONESIGNAL_APP_ID=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Sentry project DSN (public client identifier). Optional override; builds fall
# back to the production DSN in src/app/_layout.tsx when this is empty.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_MAESTRO_E2E=0
