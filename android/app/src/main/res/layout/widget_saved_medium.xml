<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="@drawable/widget_container_bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/widget_icon"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@string/widget_icon_description"
      android:src="@android:drawable/ic_menu_my_calendar" />

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/meetcal_title"
      android:textColor="@color/widget_blue"
      android:textSize="12sp"
      android:textStyle="bold" />
  </LinearLayout>

  <View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="8dp"
    android:background="@color/widget_divider" />

  <TextView
    android:id="@+id/widget_empty"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/no_saved_sessions"
    android:textColor="@color/widget_text_secondary"
    android:textSize="12sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/row1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/platform1"
      android:layout_width="wrap_content"
      android:layout_height="20dp"
      android:gravity="center"
      android:minWidth="45dp"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:text="Red"
      android:textColor="@color/widget_chip_text"
      android:textSize="11sp"
      android:background="@drawable/widget_chip_blue" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/session_title1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session 1 • 8:00 AM"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/session_subtitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M81"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/row2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/platform2"
      android:layout_width="wrap_content"
      android:layout_height="20dp"
      android:gravity="center"
      android:minWidth="45dp"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:text="Blue"
      android:textColor="@color/widget_chip_text"
      android:textSize="11sp"
      android:background="@drawable/widget_chip_blue" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/session_title2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session 2 • 10:30 AM"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/session_subtitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="W71"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/row3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
      android:id="@+id/platform3"
      android:layout_width="wrap_content"
      android:layout_height="20dp"
      android:gravity="center"
      android:minWidth="45dp"
      android:paddingStart="10dp"
      android:paddingEnd="10dp"
      android:text="Stars"
      android:textColor="@color/widget_chip_text"
      android:textSize="11sp"
      android:background="@drawable/widget_chip_blue" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/session_title3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Session 3 • 2:00 PM"
        android:textColor="@color/widget_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/session_subtitle3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M102"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
