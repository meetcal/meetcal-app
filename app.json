{
  "expo": {
    "name": "MeetCal",
    "slug": "meetcal",
    "version": "3.4.0",
    "orientation": "portrait",
    "icon": {
      "light": "./ios/MeetCal/Images.xcassets/AppIcon.appiconset/liquid-glass-iOS-Dark-1024x1024@1x.png",
      "dark": "./ios/MeetCal/Images.xcassets/AppIcon.appiconset/liquid-glass-iOS-Default-1024x1024@1x.png"
    },
    "scheme": "meetcal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "3.4.0",
    "updates": {
      "url": "https://u.expo.dev/a0017b93-a31e-42b1-b36a-11cb5eedf11f",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.memohnsen.meetcal",
      "usesIcloudStorage": true,
      "icon": {
        "light": "./ios/MeetCal/Images.xcassets/AppIcon.appiconset/liquid-glass-iOS-Default-1024x1024@1x.png",
        "dark": "./ios/MeetCal/Images.xcassets/AppIcon.appiconset/liquid-glass-iOS-Dark-1024x1024@1x.png",
        "tinted": "./ios/MeetCal/Images.xcassets/AppIcon.appiconset/liquid-glass-iOS-Default-1024x1024@1x.png"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUbiquitousContainers": {
          "iCloud.com.memohnsen.meetcal": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Meet Calendar",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        },
        "SKPaymentTransactions": true,
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "2U9PT9HC89.skadnetwork"
          }
        ],
        "NSCalendarsFullAccessUsageDescription": "MeetCal needs calendar access to add weightlifting competition sessions to your calendar. This allows you to receive reminders for your weigh-in and competition times.",
        "NSCalendarsUsageDescription": "MeetCal needs calendar access to add weightlifting competition sessions to your calendar. This allows you to receive reminders for your weigh-in and competition times."
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.memohnsen.meetcal"
        ],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher_foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.memohnsen.meetcal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#242831",
      "dark": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#242831"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/MeetCal.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/MeetCal.png",
          "color": "#ffffff",
          "sounds": ["./assets/sounds/notification.wav"],
          "android": {
             "icon": "./assets/images/ic_stat_meetcal_android.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a0017b93-a31e-42b1-b36a-11cb5eedf11f"
      }
    },
    "owner": "memohnsen"
  }
}
