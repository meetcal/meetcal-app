{
  "expo": {
    "name": "MeetCal",
    "slug": "meetcal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memohnsen.meetcal",
      "usesIcloudStorage": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUbiquitousContainers": {
          "iCloud.com.memohnsen.meetcal": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Meet Calendar",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        },
        "SKPaymentTransactions": true,
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "2U9PT9HC89.skadnetwork"
          }
        ]
      },
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.memohnsen.meetcal"
        ],
        "com.apple.developer.icloud-services": [
          "CloudKit"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false,
        "usesIAP": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.memohnsen.meetcal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a0017b93-a31e-42b1-b36a-11cb5eedf11f"
      }
    },
    "owner": "memohnsen"
  }
}
