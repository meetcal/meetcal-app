{
  "cli": {
    "version": ">= 3.13.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      }
    },
    "production-apk": {
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk",
        "image": "ubuntu-24.04-jdk-17-ndk-r27b"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6741133286",
        "appleTeamId": "HCK9FFW6UX"
      }
    }
  }
}
