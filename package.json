{
  "name": "meetcal",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "simgate run --platform ios --bundle-id com.memohnsen.meetcal --open-url 'exp+meetcal://expo-development-client/?url=http%3A%2F%2Flocalhost%3A{port}' -- expo start",
    "android": "simgate run --platform android -- expo run:android",
    "ios": "simgate run --platform ios --bundle-id com.memohnsen.meetcal --record-build -- expo run:ios --device {udid}",
    "web": "simgate run --platform web -- expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --watchman=false",
    "test:coverage": "jest --ci --watchman=false --coverage --coverageDirectory=coverage --coverageReporters=text-summary --coverageReporters=lcov",
    "typecheck": "tsrs --noEmit",
    "typecheck:convex": "tsrs --noEmit -p convex/tsconfig.json",
    "lint": "expo lint --max-warnings 0",
    "maestro:bootstrap": "xcrun simctl terminate ${SIMGATE_UDID:-booted} ${APP_ID:-com.memohnsen.meetcal} || true; xcrun simctl openurl ${SIMGATE_UDID:-booted} \"${DEV_CLIENT_URL:-exp+meetcal://expo-development-client/?url=http%3A%2F%2F192.168.0.114%3A${SIMGATE_PORT:-8081}}\"",
    "maestro:test": "simgate run --platform ios --bundle-id com.memohnsen.meetcal -- bun scripts/maestro-session.ts .maestro",
    "maestro:test:flow": "simgate run --platform ios --bundle-id com.memohnsen.meetcal -- bun scripts/maestro-session.ts",
    "dev": "simgate run --platform ios --bundle-id com.memohnsen.meetcal --open-url 'exp+meetcal://expo-development-client/?url=http%3A%2F%2Flocalhost%3A{port}' -- expo start",
    "update:prod": "EXPO_PUBLIC_CONVEX_URL=https://disciplined-hare-790.convex.cloud eas update --branch production --non-interactive"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/jest/device-timezone-environment.js",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/app/**/*.{ts,tsx}",
      "src/components/**/*.{ts,tsx}",
      "src/hooks/**/*.{ts,tsx}",
      "src/lib/**/*.{ts,tsx}",
      "src/utils/**/*.{ts,tsx}",
      "src/contexts/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}",
      "!**/*.spec.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/web/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/web/"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/scrapers/"
    ]
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@clerk/expo": "4.15.1",
    "@clerk/expo-native-components": "0.4.4",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-menu/menu": "2.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "8.34.0",
    "@shopify/flash-list": "2.3.3",
    "@types/pako": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "buffer": "^6.0.3",
    "convex": "^1.49.0",
    "date-fns": "^4.1.0",
    "expo": "~58.0.24",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.18",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.19",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-insights": "~58.0.11",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "node-html-parser": "^9.0.7",
    "onesignal-expo-plugin": "2.8.0",
    "pako": "^3.0.3",
    "posthog-react-native": "^4.86.0",
    "pretty-format": "^30.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-onesignal": "^5.5.17",
    "react-native-purchases": "11.0.2",
    "react-native-purchases-ui": "11.0.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-view-shot": "6.2.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-native": "^5.0.0",
    "estraverse": "^4.3.0",
    "fast-check": "^4.10.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "jest-worker": "^27.5.1",
    "mupdf": "^1.28.1",
    "react-test-renderer": "19.3.1",
    "supports-color": "^11.0.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "~6.0.3",
    "webpack": "^5.112.2"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "glob": "9.3.5",
    "lodash": "4.17.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-test-renderer": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "serialize-javascript": "7.0.3",
    "undici": "6.24.0"
  },
  "private": true,
  "patchedDependencies": {
    "@react-native-menu/menu@2.0.0": "patches/@react-native-menu%2Fmenu@2.0.0.patch"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-view-shot",
        "@sentry/react-native"
      ]
    }
  }
}
