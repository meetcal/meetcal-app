{
  "name": "meetcal",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "maestro:bootstrap": "xcrun simctl terminate booted ${APP_ID:-com.memohnsen.meetcal} || true; xcrun simctl openurl booted \"${DEV_CLIENT_URL:-exp+meetcal://expo-development-client/?url=http%3A%2F%2F192.168.0.114%3A8081}\"",
    "maestro:test": "bun run maestro:bootstrap && maestro test -e APP_ID=${APP_ID:-com.memohnsen.meetcal} .maestro",
    "maestro:test:flow": "bun run maestro:bootstrap && maestro test -e APP_ID=${APP_ID:-com.memohnsen.meetcal}",
    "dev": "APP_VARIANT=development bunx expo start",
    "update:prod": "eas update --branch production --non-interactive"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
