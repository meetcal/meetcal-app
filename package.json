{
  "name": "meetcal",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bun scripts/metro-lock.ts expo start",
    "android": "bun scripts/metro-lock.ts expo run:android",
    "ios": "bun scripts/metro-lock.ts expo run:ios",
    "web": "bun scripts/metro-lock.ts expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --watchman=false",
    "test:coverage": "jest --ci --watchman=false --coverage --coverageDirectory=coverage --coverageReporters=text-summary --coverageReporters=lcov",
    "typecheck": "tsrs --noEmit",
    "lint": "expo lint --max-warnings 0",
    "maestro:bootstrap": "xcrun simctl terminate booted ${APP_ID:-com.memohnsen.meetcal} || true; xcrun simctl openurl booted \"${DEV_CLIENT_URL:-exp+meetcal://expo-development-client/?url=http%3A%2F%2F192.168.0.114%3A8081}\"",
    "maestro:test": "bun scripts/metro-lock.ts bun scripts/maestro-session.ts .maestro",
    "maestro:test:flow": "bun scripts/metro-lock.ts bun scripts/maestro-session.ts",
    "dev": "bun scripts/metro-lock.ts expo start",
    "update:prod": "EXPO_PUBLIC_CONVEX_URL=https://disciplined-hare-790.convex.cloud eas update --branch production --non-interactive"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/jest/device-timezone-environment.js",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "src/app/**/*.{ts,tsx}",
      "src/components/**/*.{ts,tsx}",
      "src/hooks/**/*.{ts,tsx}",
      "src/lib/**/*.{ts,tsx}",
      "src/utils/**/*.{ts,tsx}",
      "src/contexts/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}",
      "!**/*.spec.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/web/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/web/"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/scrapers/"
    ]
  },
  "dependencies": {
    "@bacons/apple-targets": "^3.0.2",
    "@clerk/expo": "4.13.0",
    "@clerk/expo-native-components": "0.2.0",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-menu/menu": "2.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@types/pako": "^2.0.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "buffer": "^6.0.3",
    "convex": "^1.46.0",
    "date-fns": "^4.1.0",
    "expo": "58.0.14",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.13",
    "expo-blur": "~58.0.4",
    "expo-build-properties": "~58.0.11",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
