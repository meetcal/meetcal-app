{
  "name": "meetcal",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --watchman=false",
    "test:coverage": "jest --ci --watchman=false --coverage --coverageDirectory=coverage --coverageReporters=text-summary --coverageReporters=lcov",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "maestro:bootstrap": "xcrun simctl terminate booted ${APP_ID:-com.memohnsen.meetcal} || true; xcrun simctl openurl booted \"${DEV_CLIENT_URL:-exp+meetcal://expo-development-client/?url=http%3A%2F%2F192.168.0.114%3A8081}\"",
    "maestro:test": "bun run maestro:bootstrap && maestro test -e APP_ID=${APP_ID:-com.memohnsen.meetcal} .maestro",
    "maestro:test:flow": "bun run maestro:bootstrap && maestro test -e APP_ID=${APP_ID:-com.memohnsen.meetcal}",
    "dev": "bunx expo start",
    "update:prod": "eas update --branch production --non-interactive"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "utils/**/*.{ts,tsx}",
      "contexts/**/*.{ts,tsx}",
      "!**/*.test.{ts,tsx}",
      "!**/*.spec.{ts,tsx}"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/scrapers/"
    ]
  },
  "dependencies": {
    "@bacons/apple-targets": "^3.0.2",
    "@clerk/clerk-js": "6.19.0",
    "@clerk/expo": "3.5.1",
    "@clerk/react": "6.10.3",
    "@clerk/shared": "4.19.1",
    "@expo/metro-runtime": "~58.0.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-menu/menu": "2.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "8.27.0",
    "@shopify/flash-list": "2.0.2",
    "@types/pako": "^2.0.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "date-fns": "^4.1.0",
    "expo": "^58.0.0-preview.3",
    "expo-application": "~58.0.1",
    "expo-auth-session": "~58.0.2",
    "expo-blur": "~58.0.0",
    "expo-build-properties": "~58.0.3",
    "expo-calendar": "~58.0.2",
    "expo-constants": "~58.0.3",
    "expo-crypto": "~58.0.1",
    "expo-dev-client": "~58.0.3",
    "expo-device": "~58.0.0",
    "expo-document-picker": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.1",
    "expo-glass-effect": "~58.0.0",
    "expo-haptics": "~58.0.1",
    "expo-insights": "~58.0.3",
    "expo-linear-gradient": "~58.0.0",
    "expo-linking": "~58.0.3",
    "expo-localization": "~58.0.0",
    "expo-notifications": "~58.0.3",
    "expo-router": "~58.0.4",
    "expo-secure-store": "~58.0.0",
    "expo-sharing": "~58.0.6",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-store-review": "~58.0.0",
    "expo-symbols": "~58.0.1",
    "expo-system-ui": "~58.0.1",
    "expo-updates": "~58.0.5",
    "expo-web-browser": "~58.0.0",
    "onesignal-expo-plugin": "2.7.1",
    "pako": "^2.1.0",
    "posthog-react-native": "^4.37.3",
    "pretty-format": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.88.0-rc.0",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-onesignal": "^5.3.5",
    "react-native-purchases": "10.10.0",
    "react-native-purchases-ui": "10.10.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "^15.15.3",
    "react-native-view-shot": "6.0.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.88.0-rc.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.23",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "eslint-config-expo": "~58.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "estraverse": "^4.3.0",
    "jest": "^29.2.1",
    "jest-expo": "~58.0.2",
    "jest-worker": "^27.5.1",
    "react-test-renderer": "19.2.3",
    "supports-color": "^8.1.1",
    "typescript": "~6.0.3",
    "webpack": "^5.105.2"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "glob": "9.3.5",
    "lodash": "4.17.23",
    "minimatch": "3.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3",
    "react-server-dom-webpack": "19.2.3",
    "serialize-javascript": "7.0.3",
    "undici": "6.24.0"
  },
  "private": true,
  "patchedDependencies": {
    "onesignal-expo-plugin@2.7.1": "patches/onesignal-expo-plugin@2.7.1.patch",
    "@react-native-menu/menu@2.0.0": "patches/@react-native-menu%2Fmenu@2.0.0.patch"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-view-shot",
        "@sentry/react-native"
      ]
    }
  }
}
