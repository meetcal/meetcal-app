    "react-native-gesture-handler": "~3.3.0",
    "react-native-onesignal": "^5.3.5",
    "react-native-purchases": "10.10.0",
    "react-native-purchases-ui": "10.10.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.23",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-native": "^5.0.0",
    "estraverse": "^4.3.0",
    "fast-check": "^4.10.2",
    "jest": "^29.2.1",
    "jest-expo": "~58.0.11",
    "jest-worker": "^27.5.1",
    "mupdf": "^1.28.1",
    "react-test-renderer": "19.3.0",
    "supports-color": "^8.1.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "~6.0.3",
    "webpack": "^5.105.2"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "glob": "9.3.5",
    "lodash": "4.17.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "serialize-javascript": "7.0.3",
    "undici": "6.24.0"
  },
  "private": true,
  "patchedDependencies": {
    "@react-native-menu/menu@2.0.0": "patches/@react-native-menu%2Fmenu@2.0.0.patch"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-view-shot",
        "@sentry/react-native"
      ]
    }
  }
}
