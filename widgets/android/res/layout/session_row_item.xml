<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/session_row_background"
    android:padding="6dp"
    android:layout_marginBottom="2dp">

    <!-- Platform indicator -->
    <View
        android:id="@+id/platform_indicator"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/widget_text_secondary"
        android:layout_marginEnd="8dp" />

    <!-- Session info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/session_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session 1"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/platform_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Red"
                android:textSize="9sp"
                android:textColor="#FF0000"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:00 AM"
                android:textSize="9sp"
                android:textColor="@color/widget_text_secondary" />

        </LinearLayout>

        <TextView
            android:id="@+id/weight_class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Women 55kg A"
            android:textSize="8sp"
            android:textColor="@color/widget_text_secondary"
            android:layout_marginTop="1dp" />

    </LinearLayout>

</LinearLayout>